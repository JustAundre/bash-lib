#!/usr/bin/env bash
log() {
	# ANSII escapes for coloring output
	local type
	#
	# Catch arguments (if no input in args, grab input from stdin.)
	type="${1}"
	shift 1
	if [[ -t 0 && -n "${1}" ]]; then
		input=("${@}")
	elif [[ ! -t 0 ]]; then
		input=("$(< /dev/stdin)")
	fi
	#
	# If no input, error out.
	if [[ "${#input[@]}" -lt 1 ]]; then
		log e 'Missing message for "log" library command.'
		return 2
	fi
	#
	# Parse input
	case "${type}" in
	i) printf -- '%bi: %s%b\n' "${ansii[rev]}${ansii[cyan]}" "${input[@]}" "${ansii[reset]}" ;;
	w) printf -- '%bW: %s%b\n' "${ansii[rev]}${ansii[yellow]}" "${input[@]}" "${ansii[reset]}" >&2 ;;
	e) printf -- '%bE: %s%b\n' "${ansii[rev]}${ansii[red]}" "${input[@]}" "${ansii[reset]}" >&2 ;;
	*)
		log e "Invalid log type \"${type}\". Valid options are \"i\" (info), \"w\" (warning), or \"e\" (error)."
		return 3
		;;
	esac
}
export -f log
