#!/usr/bin/env bash

cl-new() {
	# Grab args
	local ui selection offset=0 current_index=0 multi=0 optional=0 entries=() selections=() PS2="${PS2:-\"Pick a card any card!\"}"
	exec {ui}>&2
	while ((${#} > 0)); do
	  	case "${1}" in
		--multi)
			multi=1
			shift
			;;
		--optional)
			optional=1
			shift
			;;
		--)
			shift
			break
			;;
		--*)
			log e "cl-new: invalid long-form option: ${1@Q}"
			return 2
			;;
		-*)
			for ((i=1; i<${#1}; i++)); do
				case "${1:i:1}" in
				m)
					multi=1
					;;
				o)
					optional=1
					;;
				*)
					log e "cl-new: invalid short-form option: -${1:i:1}"
					return 2
					;;
				esac
			done
			shift
			;;
		*)
			break
			;;
		esac
	done
	entries=("${@}")
	if ((${#entries[@]} == 0)); then
		log e 'cl-new: no items to display for user to select from.'
		return 1
	fi
	((optional)) || PS2="* ${PS2}"
	#
	# UI Renderer
	clear -x >&"${ui}"
	render_ui() {
		local -i display_count=10 visible_start=offset visible_end
		local ornament margin indicator result
		result+=$'\033[H\033[J'
		#
		# Keep current_index in view
		if ((current_index < offset)); then
			offset="${current_index}"
		elif ((current_index >= offset + display_count)); then
			offset="$((current_index - display_count + 1))"
		fi
		#
		# Calculate visible range
		if ((${#entries[@]} <= display_count)); then
			visible_start=0
			visible_end="$((${#entries[@]} - 1))"
			offset=0
		else
			visible_end=$((offset + display_count - 1))
			if ((visible_end >= ${#entries[@]})); then
				visible_end="$((${#entries[@]} - 1))"
				visible_start=$((visible_end - display_count + 1))
				offset="${visible_start}"
			else
				visible_start="${offset}"
			fi
		fi
		result+="${ansii[lime]}${ansii[rev]}${PS2}${ansii[reset]}"$'\n'
		result+="${ansii[dim]}↑/↓ to scroll | [SPACE] to select | [ENTER] to confirm${ansii[reset]}"$'\n'
		#
		# Show scroll indicator (top)
		if ((offset > 0)); then
			result+="${ansii[dim]}$((${#entries[@]} - (${#entries[@]} - current_index) + 1))/${#entries[@]}		▲  ▲  ▲  ▲  ▲${ansii[reset]}"$'\n'
		else
			result+="${ansii[dim]}$((${#entries[@]} - (${#entries[@]} - current_index) + 1))/${#entries[@]}${ansii[reset]}"$'\n'
		fi
		#
		# Display items
		for ((i = visible_start; i <= visible_end && i < ${#entries[@]}; i++)); do
			local is_selected=0
			for sel in "${selections[@]}"; do
				if [[ ${sel} == "${i}" ]]; then
					is_selected=1
					break
				fi
			done
			#
			# Check if this is the current item (cursor position)
			ornament=''
			((is_selected)) && ornament="${ansii[rev]}"
			margin='    '
			((i == current_index)) && margin='  > '
			indicator=' '
			((is_selected)) && indicator='*'
			if ((multi)); then
				indicator="[${indicator}]"
			else
				indicator="(${indicator})"
			fi
			result+="${ornament}${margin}${indicator} ${entries[${i}]}${ansii[reset]}"$'\n'
		done
		#
		# Show scroll indicator (bottom)
		if ((visible_end < ${#entries[@]} - 1)); then
			result+="${ansii[dim]}		▼  ▼  ▼  ▼  ▼${ansii[reset]}"
		fi
		echo "${result}"
	}
	#
	# Handle keyboard input
	read_input() {
		local key key2 IFS=''
		trap 'return 130' SIGINT
		read -sn1 key || return 130
		if [[ ${key} == $'\E' ]]; then
			read -rsn2 key2 || return 130
			key+="${key2}"
		fi
		case "${key}" in
		# Up arrow
		$'\E[A')
			if ((current_index > 0)); then
				((current_index--))
			else
				return 2
			fi
			return 1
			;;
		#
		# Down arrow
		$'\E[B')
			if ((current_index < ${#entries[@]} - 1)); then
				((current_index++))
			else
				return 2
			fi
			return 1
			;;
		#
		# Space - Toggle selection
		' ')
			local is_selected=0
			for ((i = 0; i < ${#selections[@]}; i++)); do
				if [[ "${selections[$i]}" == "${current_index}" ]]; then
					is_selected=1
					unset 'selections[$i]'
					selections=("${selections[@]}")
					break
				fi
			done
			if ((! is_selected)); then
				((multi)) || selections=()
				selections+=("${current_index}")
			fi
			return 1
			;;
		#
		# Enter
		'')
			((optional || ${#selections[@]})) && return 0
			return 2
			;;
		#
		# Unknown input
		*)
			return 2
			;;
		esac
	}
	#
	# Main loop
	{
		render_ui
		until read_input; do
			exit_code="${?}"
			if ((exit_code == 130)); then
				return 130
			elif ((exit_code != 2)); then
				render_ui
			fi
		done
		printf '\033[H\033[J'
	} >&"${ui}"
	#
	# Error on no response. Validate selections and return null-delimited selections.
	[[ "${#selections[@]}" == 0 ]] && return 0
	((! multi)) && [[ "${#selections[@]}" -gt 1 ]] && return 2
	if ((multi)); then
		for selection in "${selections[@]}"; do
			printf '%s\0' "${entries["${selection}"]}"
		done
	else
		printf '%s' "${entries["${selections[0]}"]}"
	fi
	unset read_input render_ui
}
export -f cl-new
