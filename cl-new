#!/usr/bin/env bash

cl-new() {
	# Grab args
	local ui='' selection offset=0 total_items entries multi=0 title='"Pick a card any card!"'
	exec {ui}>&2
	local -a entries selections
	local -i current_index=0
	eval set -- "$(getopt --options mt: --longoptions multi,title: -- "$@")"
	while true; do
		case "${1}" in
			-m|--multi)
				multi=1
				shift
			;;
			-t|--title)
				title="${2}"
				shift 2
			;;
			--)
				shift
				break
			;;
			*)
				break
			;;
		esac
	done
	entries=("${@}")
	if ((${#entries[@]} == 0)); then
		log w 'No items to display for user to select from.'
		return 1
	fi
	#
	# UI Renderer
	clear -x >&"${ui}"
	render_ui() {
		local -i visible_start=offset visible_end
		local -i display_count=7
		#
		# Keep current_index in view
		if (( current_index < offset )); then
			offset=$current_index
		elif (( current_index >= offset + display_count )); then
			offset=$((current_index - display_count + 1))
		fi
		#
		# Calculate visible range
		if ((${#entries[@]} <= display_count)); then
			visible_start=0
			visible_end="$((${#entries[@]} - 1))"
			offset=0
		else
			visible_end=$((offset + display_count - 1))
			if ((visible_end >= ${#entries[@]})); then
				visible_end="$((${#entries[@]} - 1))"
				visible_start=$((visible_end - display_count + 1))
				offset="${visible_start}"
			else
				visible_start="${offset}"
			fi
		fi
		[[ -n "${PS3}" ]] && echo "${PS3}"
		printf '%b%s\n' "${ansii[rev]}" '↑/↓ to scroll | [SPACE] to select | [ENTER] to confirm'
		if ((multi)); then
			printf '%s' 'Multi-select -- '
		else
			printf '%s' 'Single-select -- '
		fi
		printf '%s%b\n' "${title}" "${ansii[reset]}"
		#
		# Show scroll indicator (top)
		if ((offset > 0)); then
			printf '%b%s from top\t↑  ↑  ↑  ↑  ↑%b\n' "${ansii[dim]}" "$((${#entries[@]} - (${#entries[@]} - current_index)))" "${ansii[reset]}"
		else
			printf '%b%s from top%b\n' "${ansii[dim]}" "$((${#entries[@]} - (${#entries[@]} - current_index)))" "${ansii[reset]}"
		fi
		#
		# Display items
		for ((i = visible_start; i <= visible_end && i < ${#entries[@]}; i++)); do
			local is_selected=0
			for sel in "${selections[@]}"; do
				if [[ ${sel} == "${i}" ]]; then
					is_selected=1
					break
				fi
			done
			#
			# Check if this is the current item (cursor position)
			if ((i == current_index)); then
				# Highlight current item with reverse video
				if ((is_selected)); then
					printf '  %b> [*] %s%b\n' "${ansii[rev]}" "${entries[${i}]}" "${ansii[reset]}"
				else
					printf '  %b> [ ] %s%b\n' "${ansii[rev]}" "${entries[${i}]}" "${ansii[reset]}"
				fi
			else
				if ((is_selected)); then
					printf '    %b[*]%b %s\n' "${ansii[bold]}" "${ansii[reset]}" "${entries[${i}]}"
				else
					printf '    [ ] %s\n' "${entries[${i}]}"
				fi
			fi
		done
		#
		# Show scroll indicator (bottom)
		if ((visible_end < ${#entries[@]} - 1)); then
			printf '%b%s from bott.\t↓  ↓  ↓  ↓  ↓%b\n' "${ansii[dim]}" "$(((current_index - ${#entries[@]} + 1) * -1))" "${ansii[reset]}"
		else
			printf '%b%s from bott.%b\n' "${ansii[dim]}" "$(((current_index - ${#entries[@]} + 1) * -1))" "${ansii[reset]}"
		fi
	}
	#
	# Handle keyboard input
	read_input() {
		local key key2
		IFS= read -sn1 key
		if [[ ${key} == $'\E' ]]; then
			IFS= read -sn2 key2
			key+="${key2}"
		fi
		case "${key}" in
		# Up arrow
		$'\E[A')
			if ((current_index > 0)); then
				((current_index--))
			else
				return 2
			fi
			return 1
		;;
		#
		# Down arrow
		$'\E[B')
			if ((current_index < ${#entries[@]} - 1)); then
				((current_index++))
			else
				return 2
			fi
			return 1
		;;
		#
		# Space - Toggle selection
		' ')
			local is_selected=0
			for ((i = 0; i < ${#selections[@]}; i++)); do
				if [[ "${selections[$i]}" == "${current_index}" ]]; then
					is_selected=1
					unset 'selections[$i]'
					selections=("${selections[@]}")
					break
				fi
			done
			if ((!is_selected)); then
				((multi)) || selections=()
				selections+=("${current_index}")
			fi
			return 1
		;;
		#
		# Enter
		'')
			return 0
		;;
		#
		# Unknown input
		*)
			return 2
		;;
		esac
	}
	#
	# Main loop
	render_ui >&"${ui}"
	until read_input; do
		if ((${?} != 2)); then
			printf '\033[H\033[J' >&"${ui}"
			render_ui >&"${ui}"
		fi
	done
	#
	# Do nothing with empty responses and validate user choices then return the choices.
	[[ "${#selections[@]}" == 0 ]] && return 0
	((!multi)) && [[ "${#selections[@]}" -gt 1 ]] && return 2
	for selection in "${selections[@]}"; do
		printf '%s\0' "${entries["${selection}"]}"
	done
	printf '\033[H\033[J' >&"${ui}"
}
export -f cl-new